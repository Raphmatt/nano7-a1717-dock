+# macOS: there is no sg_raw, but macOS publishes Apple's SCSITaskUserClient on every
+# iPod (com_apple_driver_iPodSBCNub, category "iPodUserClientDevice" — the channel
+# iTunes/Finder use). tools/macos/ipod_sg_raw.c drives it with sg_raw's CLI, and
+# diskutil covers mount / eject / repair, none of it needing root.
+SGRAW_SRC = ROOT / "tools" / "macos" / "ipod_sg_raw.c"
+SGRAW_BIN = ROOT / "tools" / "macos" / "ipod_sg_raw"
+
+
+def _ensure_ipod_sg_raw(build=True):
+    """Build tools/macos/ipod_sg_raw from the .c next to it on first use (needs the
+    Xcode Command Line Tools' clang). True when the binary is present + current."""
+    if SGRAW_BIN.is_file() and SGRAW_BIN.stat().st_mtime >= SGRAW_SRC.stat().st_mtime:
+        return True
+    if not build:
+        return False
+    print("    -> building tools/macos/ipod_sg_raw")
+    r = subprocess.run(["xcrun", "clang", "-O2", "-Wno-deprecated-declarations",
+                        "-framework", "IOKit", "-framework", "CoreFoundation",
+                        "-o", str(SGRAW_BIN), str(SGRAW_SRC)])
+    return r.returncode == 0 and SGRAW_BIN.is_file()
+
+
+# Prepended to every device-side bash snippet on macOS: the Linux tool names the
+# snippets use, as shell functions over ipod_sg_raw + diskutil. sudo is a no-op
+# (nothing here needs root on macOS).
+_DARWIN_PREAMBLE = r"""
+_SGRAW='@SGRAW@'
+sudo() { "$@"; }
+sg_raw() { "$_SGRAW" "$@"; }
+sg_start() { "$_SGRAW" x 1b 00 00 00 03 00; }   # --loej: START STOP UNIT LOEJ|START -> Connected mode
+eject() { diskutil eject "$1" >/dev/null 2>&1; }
+udisksctl() { return 1; }
+umount() { local n=$#; local t="${!n}"; diskutil unmount "$t" >/dev/null 2>&1 || diskutil unmountDisk "$t" >/dev/null 2>&1; }
+mount() { local n=$#; local m="${!n}"; local i=$((n-1)); local p="${!i}"; diskutil mount -mountPoint "$m" "$p" >/dev/null 2>&1; }
+fsck.vfat() { local n=$#; local t="${!n}"; diskutil repairVolume "$t" >/dev/null 2>&1; }
+"""
+
+# Whole-disk node whose media name is "iPod" (/dev/diskN). After an eject the node is
+# gone, so kick the iPod back into Connected mode and wait for it.
+_DARWIN_FIND_DISK = r"""
+find_ipod() { for d in $(diskutil list 2>/dev/null | grep -o '^/dev/disk[0-9]*'); do diskutil info "$d" 2>/dev/null | grep -q 'Device / Media Name: *iPod$' && { echo "$d"; return 0; }; done; return 1; }
+find_ipod && exit 0
+sg_start x --loej 2>/dev/null || true
+for i in $(seq 1 20); do find_ipod && exit 0; sleep 1; done
+exit 1
+"""
+
+
+def _darwin_preamble():
+    _ensure_ipod_sg_raw()
+    return _DARWIN_PREAMBLE.replace("@SGRAW@", str(SGRAW_BIN))
+
